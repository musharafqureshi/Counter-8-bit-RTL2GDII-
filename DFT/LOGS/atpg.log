Usage:  write_patterns  <pattern_filename> [ <format_switch> ]
                                          [ -PATTERN_SEts [chain] [scan] [burnin_loop] [lvx_loop] [lvx_verification] ]
                                          [ -Replace ]
                                          [ -PROcfile <procedure_filename> ]
                                          [ -PARAMeter_file <parameter_filename> ]
                                          [ -PARAMETER_List <list_parameter_pairs> ]
                                          [ -PARALlel | -Serial ]
                                          [ -BEgin {<pattern_number> | <pattern_name>} ]
                                          [ -END {<pattern_number> | <pattern_name>} ]
                                          [ -TAg <tag_name> ]
                                          [ -CEll_placement { Bottom | Top | None } ]
                                          [ -ENVironment ]
                                          [ -TEST_Setup { ONLy | ONE | OFf | ONE_Per_file } ]
                                          [ -TEST_End { ONLy | ONE | OFf } ]
                                          [ -TEST_Payload ]
                                          [ -ALL_Setup_only ]
                                          [ -ALL_End_only ]
                                          [ -EXternal ]
                                          [ -SAmple [ <integer> ] ]
                                          [ -IDDQ_file ]
                                          [ -MODE_Internal | -MODE_External ]
                                          [ -NOPadding | -PAD0 | -PAD1 ]
                                          [ -MAXloads <load_number> [-ADD_pattern_index_range_to_filename | -ADD_Load_range_to_filename] ]
                                          [ -PATtern_size <integer> ]
                                          [ -MEMory_size <size_in_KB> ]
                                          [ -SCAN_Memory_size <size_in_KB> ]
                                          [ -VECTOR_Set <TCL_vector_set_definition> ]
                                          [ -VERBose ]

Values of format_switch:  -Ascii, -BInary, -Wgl, -Verilog, -Stil1999, -CTl2005,
